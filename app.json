{
  "expo": {
    "name": "BDK Trivia",
    "slug": "bdk-trivia",
    "scheme": "bdktrivia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bdklogo.jpg",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bdk.bibletrivia",
      "supportsTablet": true,
      "icon": "./assets/bdklogo.jpg",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a picture for a Bible trivia question.",
        "NSCameraUsageDescription": "Take a picture for a Bible trivia question."
      }
    },
    "android": {
      "package": "com.bdk.bibletrivia",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8",
        "foregroundImage": "./assets/bdklogo.jpg",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/bdklogo.jpg"
    },
    "splash": {
      "backgroundColor": "#F5F0E8",
      "image": "./assets/bdklogo.jpg",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a picture for a Bible trivia question.",
          "cameraPermission": "Take a picture for a Bible trivia question.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1745ebb2-ebf4-4df3-afe0-025c9011eb3e"
      }
    }
  }
}
